require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']

  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_HERMES_V1_ENABLED'] ||= '0' if podfile_properties['expo.useHermesV1'] == 'false'
# An explicit `ios.usePrecompiledModules: false` must win even when the env var is already set
# (e.g. EXPO_USE_PRECOMPILED_MODULES exported by EAS Build), so force-disable here before the default.
ENV['EXPO_USE_PRECOMPILED_MODULES'] = '0' if podfile_properties['EXPO_USE_PRECOMPILED_MODULES'] == 'false'
ENV['EXPO_USE_PRECOMPILED_MODULES'] ||= '1'
platform :ios, podfile_properties['ios.deploymentTarget'] || '16.4'

prepare_react_native_project!

target 'Flick' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # Xcode 26 / iOS 26 SDK: CocoaPods prefix headers include <string.h>
    # before MMKVCore can set __STDC_WANT_LIB_EXT1__, so memset_s is undeclared.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'MMKVCore'
      target.build_configurations.each do |config|
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        defs = ['$(inherited)'] if defs.nil?
        defs = [defs] unless defs.is_a?(Array)
        unless defs.any? { |d| d.to_s.include?('__STDC_WANT_LIB_EXT1__') }
          defs << '__STDC_WANT_LIB_EXT1__=1'
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end
    end

    # Mac Catalyst: JitsiWebRTC has no ios-macabi slice. Compile a stub
    # module and do not link WebRTC.framework on macosx.
    webrtc_stub = File.expand_path('../macos/stubs/RNWebRTCCatalystStub.m', __dir__)
    installer.pods_project.targets.each do |target|
      if target.name == 'react-native-webrtc'
        already = target.source_build_phase.files.any? do |bf|
          ref = bf.file_ref
          ref && ref.path && File.basename(ref.path) == 'RNWebRTCCatalystStub.m'
        end
        unless already
          file_ref = installer.pods_project.new_file(webrtc_stub)
          target.source_build_phase.add_file_reference(file_ref)
        end
        target.build_configurations.each do |config|
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*]'] =
            '$(inherited) *.m *.mm'
          config.build_settings['INCLUDED_SOURCE_FILE_NAMES[sdk=macosx*]'] =
            'RNWebRTCCatalystStub.m'
        end
      end

      if target.name == 'JitsiWebRTC'
        target.shell_script_build_phases.each do |phase|
          next unless phase.name.to_s.include?('XCFrameworks')
          next if phase.shell_script.include?('Skipping JitsiWebRTC on Mac Catalyst')
          phase.shell_script =
            %(if [ "${PLATFORM_NAME}" = "macosx" ]; then echo "Skipping JitsiWebRTC on Mac Catalyst"; exit 0; fi\n) +
            phase.shell_script
        end
      end

      if target.name == 'ReactNativeStaticServer'
        stub = File.expand_path('../macos/stubs/RNStaticServerCatalystStub.mm', __dir__)
        already = target.source_build_phase.files.any? do |bf|
          ref = bf.file_ref
          ref && ref.path && File.basename(ref.path) == 'RNStaticServerCatalystStub.mm'
        end
        unless already
          file_ref = installer.pods_project.new_file(stub)
          target.source_build_phase.add_file_reference(file_ref)
        end
        target.build_configurations.each do |config|
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*]'] =
            '$(inherited) *.m *.mm'
          config.build_settings['INCLUDED_SOURCE_FILE_NAMES[sdk=macosx*]'] =
            'RNStaticServerCatalystStub.mm'
        end
        target.shell_script_build_phases.each do |phase|
          next unless phase.name.to_s.include?('Build native dependencies')
          next if phase.shell_script.include?('Skipping ReactNativeStaticServer cmake on Mac Catalyst')
          phase.shell_script = <<~'SH' + phase.shell_script
            if [ "${PLATFORM_NAME}" = "macosx" ]; then
              echo "Skipping ReactNativeStaticServer cmake on Mac Catalyst"
              mkdir -p "${BUILT_PRODUCTS_DIR}" "${TARGET_TEMP_DIR}"
              STUB_C="${TARGET_TEMP_DIR}/rnss_catalyst_stub.c"
              STUB_O="${TARGET_TEMP_DIR}/rnss_catalyst_stub.o"
              printf 'void rnss_catalyst_stub(void) {}\n' > "${STUB_C}"
              clang -c "${STUB_C}" -o "${STUB_O}"
              for lib in liblighttpd.a libmod_dirlisting.a libmod_h2.a libpcre2-8.a; do
                xcrun ar rcs "${BUILT_PRODUCTS_DIR}/${lib}" "${STUB_O}"
              done
              exit 0
            fi
          SH
        end
      end
    end

    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files/Pods-Flick/*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      next if contents.include?('FLICK_STRIPPED_WEBRTC_FOR_CATALYST')
      unless contents.sub!(/^(OTHER_LDFLAGS = .*) -framework "WebRTC"(.*)$/, '\1\2')
        next
      end
      contents << <<~XC
        FLICK_STRIPPED_WEBRTC_FOR_CATALYST = 1
        OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -framework "WebRTC"
        OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -framework "WebRTC"
      XC
      File.write(xcconfig, contents)
    end

    # JitsiWebRTC is not copied on macosx, so skip embedding WebRTC.framework
    # (otherwise frameworks.sh hits `source: unbound variable` with set -u).
    frameworks_sh = File.join(installer.sandbox.root, 'Target Support Files/Pods-Flick/Pods-Flick-frameworks.sh')
    if File.exist?(frameworks_sh)
      contents = File.read(frameworks_sh)
      unless contents.include?('FLICK_SKIP_WEBRTC_EMBED_ON_CATALYST')
        contents.gsub!(
          %r{install_framework "\$\{PODS_XCFRAMEWORKS_BUILD_DIR\}/JitsiWebRTC/WebRTC\.framework"},
          <<~'SH'.strip,
            # FLICK_SKIP_WEBRTC_EMBED_ON_CATALYST
            if [ "${PLATFORM_NAME}" != "macosx" ]; then
              install_framework "${PODS_XCFRAMEWORKS_BUILD_DIR}/JitsiWebRTC/WebRTC.framework"
            fi
          SH
        )
      end
      unless contents.include?('Vendored framework not found')
        contents.sub!(
          <<~'OLD',
            install_framework()
            {
              if [ -r "${BUILT_PRODUCTS_DIR}/$1" ]; then
                local source="${BUILT_PRODUCTS_DIR}/$1"
              elif [ -r "${BUILT_PRODUCTS_DIR}/$(basename "$1")" ]; then
                local source="${BUILT_PRODUCTS_DIR}/$(basename "$1")"
              elif [ -r "$1" ]; then
                local source="$1"
              fi
          OLD
          <<~'NEW',
            install_framework()
            {
              local source=""
              if [ -r "${BUILT_PRODUCTS_DIR}/$1" ]; then
                source="${BUILT_PRODUCTS_DIR}/$1"
              elif [ -r "${BUILT_PRODUCTS_DIR}/$(basename "$1")" ]; then
                source="${BUILT_PRODUCTS_DIR}/$(basename "$1")"
              elif [ -r "$1" ]; then
                source="$1"
              fi

              if [ -z "${source}" ]; then
                echo "warning: [CP] Vendored framework not found: $1 — skipping"
                return
              fi
          NEW
        )
      end
      File.write(frameworks_sh, contents)
    end
  end
end
