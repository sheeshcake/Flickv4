{
  "expo": {
    "name": "Flick",
    "slug": "flick",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/applogo/ic_launcher.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "flick",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/applogo/ic_launcher.png",
      "bundleIdentifier": "com.wfrdee.flick",
      "infoPlist": {
        "NSCameraUsageDescription": "Flick uses the camera so you can join a watch-party video call.",
        "NSMicrophoneUsageDescription": "Flick uses the microphone so you can join a watch-party video call.",
        "NSDocumentsFolderUsageDescription": "Flick uses Documents to store and open downloaded videos.",
        "NSDownloadsFolderUsageDescription": "Flick uses Downloads so you can save and open local files.",
        "NSDesktopFolderUsageDescription": "Flick uses Desktop so you can open local video files.",
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/applogo/ic_launcher_foreground.png",
        "backgroundImage": "./assets/applogo/ic_launcher_background.png",
        "monochromeImage": "./assets/applogo/ic_launcher_monochrome.png"
      },
      "cleartextTrafficPermitted": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": true,
      "package": "com.flickv4",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-video",
        {
          "enableBackgroundAudio": true,
          "enableAndroidPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E50914"
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      "expo-screen-orientation",
      "./plugins/withLeanbackTv",
      "./plugins/withNotifeeAndroidMaven",
      "./plugins/withMacCatalyst",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Flick uses the camera so you can join a watch-party video call.",
          "microphonePermission": "Flick uses the microphone so you can join a watch-party video call."
        }
      ]
    ]
  }
}
