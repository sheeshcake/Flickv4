# TMDB API — https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Wyzie subtitles — https://store.wyzie.io/redeem
EXPO_PUBLIC_WYZIE_BASE_URL=https://sub.wyzie.io
EXPO_PUBLIC_WYZIE_API_KEY=your_wyzie_api_key

# Sample playback source used by the video player
EXPO_PUBLIC_SAMPLE_VIDEO_URL=https://media.w3.org/2010/05/sintel/trailer.mp4

# Watch party room server (WebSocket). Leave empty to hide the feature.
# Example: wss://flickv4.nibbleph.dev
EXPO_PUBLIC_WATCH_PARTY_URL=

# FlixQuest scraper API (VOD providers + Live TV). Leave empty to hide both.
# No trailing /api/v2 — the client appends it. Example: https://flixquest-scraper.vercel.app
EXPO_PUBLIC_FLIXQUEST_API_URL=

# Party-server web catalog. Same TMDB key as EXPO_PUBLIC_TMDB_API_KEY.
# party-server also falls back to EXPO_PUBLIC_TMDB_API_KEY if this is unset.
TMDB_API_KEY=

# App versioning — used by app.config.js, android/app/build.gradle, and the
# party-server web UI (GET /health). Bump both for each release APK;
# ANDROID_VERSION_CODE must always increase.
APP_VERSION=2.1.5
ANDROID_VERSION_CODE=20105

# Optional Mac Catalyst signing identity (codesign -s). Unset = auto-detect
# Developer ID Application, then Apple Development, then ad-hoc (-).
# A real identity is required for Camera / Microphone TCC prompts.
# MACOS_CODESIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)
